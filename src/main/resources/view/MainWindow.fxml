<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane maxHeight="1.7976931348623157E308"
            maxWidth="1.7976931348623157E308"
            minHeight="-Infinity" minWidth="-Infinity"
            prefHeight="620.0" prefWidth="460.0"
            styleClass="app-root"
            stylesheets="@../css/main.css"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="larry.gui.MainWindow">
    <children>
        <TextField fx:id="userInput"
                   layoutY="566.0"
                   onAction="#handleUserInput"
                   prefHeight="46.0"
                   prefWidth="370.0"
                   promptText="Enter a command..."
                   AnchorPane.bottomAnchor="8.0"
                   AnchorPane.leftAnchor="10.0"
                   AnchorPane.rightAnchor="80.0" />
        <Button fx:id="sendButton"
                layoutX="390.0"
                layoutY="566.0"
                mnemonicParsing="false"
                onAction="#handleUserInput"
                prefHeight="46.0"
                prefWidth="64.0"
                text="Send"
                AnchorPane.bottomAnchor="8.0"
                AnchorPane.rightAnchor="8.0" />
        <ScrollPane fx:id="scrollPane"
                    fitToWidth="true"
                    hbarPolicy="NEVER"
                    hvalue="1.0"
                    pannable="true"
                    prefHeight="556.0"
                    prefWidth="460.0"
                    vvalue="1.0"
                    AnchorPane.bottomAnchor="62.0"
                    AnchorPane.leftAnchor="0.0"
                    AnchorPane.rightAnchor="0.0"
                    AnchorPane.topAnchor="0.0">
            <content>
                <VBox fx:id="dialogContainer"
                      fillWidth="true"
                      prefHeight="552.0"
                      prefWidth="448.0"
                      spacing="2.0" />
            </content>
        </ScrollPane>
    </children>
</AnchorPane>
